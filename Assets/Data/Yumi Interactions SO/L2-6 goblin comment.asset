  m_Name: L2-6 goblin comment
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: This little fast goblins are so annoying.
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: They just sprint towards you in the dark out of nowhere.
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: I can't let my guard down even for a moment.
