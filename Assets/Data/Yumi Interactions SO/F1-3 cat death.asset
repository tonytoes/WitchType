  m_Script: {fileID: 11500000, guid: ee3ef3871cf2cdb49b912311959757c7, type: 3}
  m_Name: F1-3 cat death
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: Why did I do that?...
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: No..
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: This isn't me
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: Im not a monster.
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: something has possesed my body.
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: And whoever is in control of my body right now...
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: Just know that you are a heartless cold blooded monster.
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: I hope bad things happen to you...
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: you monster...
