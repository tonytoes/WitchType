  lines:
  - speaker: {fileID: 11400000, guid: ea44e5dc10c801f4699acf4354253935, type: 2}
    text: Good day young witch
  - speaker: {fileID: 11400000, guid: ea44e5dc10c801f4699acf4354253935, type: 2}
    text: I'm Seia, an Imperial Knight. The defender of this village.
  - speaker: {fileID: 11400000, guid: ea44e5dc10c801f4699acf4354253935, type: 2}
    text: You can ask me for help when you found yourself in danger.
