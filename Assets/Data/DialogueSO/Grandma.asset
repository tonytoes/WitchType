  m_Script: {fileID: 11500000, guid: ee3ef3871cf2cdb49b912311959757c7, type: 3}
  m_Name: Grandma
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 5721928304c58de4dbd6add9d6bbb91f, type: 2}
    text: sup young lad
  - speaker: {fileID: 11400000, guid: 5721928304c58de4dbd6add9d6bbb91f, type: 2}
    text: If you wish to learn the way of the sword, I am happy to share my knowledge
      with you
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: I'll pass, magic is the meta nowadays.
  - speaker: {fileID: 11400000, guid: 5721928304c58de4dbd6add9d6bbb91f, type: 2}
    text: tch
  - speaker: {fileID: 11400000, guid: 5721928304c58de4dbd6add9d6bbb91f, type: 2}
    text: spoiled brats.
  - speaker: {fileID: 11400000, guid: 5721928304c58de4dbd6add9d6bbb91f, type: 2}
    text: Back in my days, people used to-
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: Im busy, I will go now
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: Bye!
