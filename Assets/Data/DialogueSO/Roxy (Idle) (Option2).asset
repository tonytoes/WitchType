  m_Script: {fileID: 11500000, guid: ee3ef3871cf2cdb49b912311959757c7, type: 3}
  m_Name: Roxy (Idle) (Option2)
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: I entered through the front door.
  - speaker: {fileID: 11400000, guid: de5ff9942152f60419136626569eb087, type: 2}
    text: Just because you are a witch doesn't mean you are allowed to enter other
      people's house!
  - speaker: {fileID: 11400000, guid: de5ff9942152f60419136626569eb087, type: 2}
    text: Get out you pervert!
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: My apologies if I disturbed your pleasurable time.
  - speaker: {fileID: 11400000, guid: de5ff9942152f60419136626569eb087, type: 2}
    text: GET OUT!
  - speaker: {fileID: 11400000, guid: de5ff9942152f60419136626569eb087, type: 2}
    text: NOW!!
