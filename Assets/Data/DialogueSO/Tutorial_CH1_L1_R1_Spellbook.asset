  m_Script: {fileID: 11500000, guid: ee3ef3871cf2cdb49b912311959757c7, type: 3}
  m_Name: Tutorial_CH1_L1_R1_Spellbook
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: " The tome\u2026 That wave of magic\u2026 Meguchii!\n"
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: '(She staggers to her feet, looking around, panic in her voice.)

'
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: "Don\u2019t tell me\u2026 She touched it\u2026 Even after I warned her\u2026"
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: (She clenches her fists, a mix of fear and determination.)
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: "No\u2026 I have to find her. I have to bring her back before it\u2019s
      too late."
  options: []
