  m_Name: Melon Mushroom Quest Done
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 233f13d78e948874e80f73cc0663b598, type: 2}
    text: Not bad..
  - speaker: {fileID: 11400000, guid: 233f13d78e948874e80f73cc0663b598, type: 2}
    text: This are fresh feet
  - speaker: {fileID: 11400000, guid: 233f13d78e948874e80f73cc0663b598, type: 2}
    text: mushroom feet
  - speaker: {fileID: 11400000, guid: 233f13d78e948874e80f73cc0663b598, type: 2}
    text: with this, I can continue on with my experiments
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: Uhh so... where is my sister now..?
  - speaker: {fileID: 11400000, guid: 233f13d78e948874e80f73cc0663b598, type: 2}
    text: ah, she headed north from here. Goodluck on finding your sister.
  - speaker: {fileID: 11400000, guid: b49ed812a317602409a266999ad2b928, type: 2}
    text: Thanks
